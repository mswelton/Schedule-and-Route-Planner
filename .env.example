# Copy to .env.local for local development, and set the same values as
# Environment Variables in the Vercel project settings for deploys.
#
# Every one of these is read only inside api/* (server side). None of them is
# prefixed VITE_, so none of them is ever bundled into the browser build.

# --- Supabase (server-side reads of service_locations / appointments) ---
SUPABASE_URL=https://ibjwbhwiykvsyzcnhurr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ---
# Needs the Routes API enabled, plus the Maps Static API for the map preview.
#
# Set Application restrictions to *None* and restrict the key by API instead.
# Every call is made server-side, which sends no Referer header, so an HTTP
# referrer restriction blocks all of them ("Requests from referer <empty> are
# blocked"); IP restriction does not work either, as Vercel's serverless egress
# addresses are not fixed. See the README.
GOOGLE_MAPS_API_KEY=

# --- Optional ---
# Scope every query to one operator's rows (service_locations.user_id).
# THC_USER_ID=

# Fallback base address, used only if no service_locations row has is_home=true.
# BASE_ADDRESS=
# BASE_ADDRESS_LABEL=Home

# Defaults to Australia/Melbourne.
# PLANNER_TIMEZONE=Australia/Melbourne
